# LiveKit project (Cloud or self-hosted)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech and language services used by bot.py
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Azure OpenAI — the conversation LLM. Endpoint is the resource's v1 API surface
# (ends in /openai/v1) from the Azure AI Foundry / portal. Deployment is the name
# you gave the model deployment in Azure, not the base model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Only needed if your endpoint is a regional one (e.g. https://eastus.api.cognitive.microsoft.com/)
# instead of the /openai/v1 form above — check your resource's "Model deployments" tab for the
# deployment name, and its Keys/Endpoint page for which endpoint form it gives you.
AZURE_OPENAI_API_VERSION=

# Used by livekit/place_call.py
OUTBOUND_TRUNK_ID=
CALLER_ID=9XXXXXXXXX

# RingTrunk trunk credentials — used to render livekit/*-trunk.json (never commit
# those rendered files; see livekit/render_trunk_configs.py)
RINGTRUNK_TRUNK_ID=
RINGTRUNK_SIP_PASSWORD=
RINGTRUNK_SIP_SERVER=pstn.ringtrunk.com
RINGTRUNK_SOURCE_IP=

# Cloudflare R2 (call recording storage, via LiveKit Egress) — from R2 dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
